# See the repo-root .env.example for every variable and what it does.
# Dev: copy it to webapp/.env.local. Prod: the server keeps it in /opt/lexari-web/shared/webapp.env.

# Network mode (lib/network.ts, docs/MAINNET.md): testnet (default) or mainnet. Set at build AND runtime.
# LEXARI_NETWORK=testnet
# Mainnet only: lets the server refuse a database or session secret copied from testnet (hash only, never the secret)
# LEXARI_TESTNET_DATABASE_URL=   LEXARI_TESTNET_SESSION_SECRET_SHA256=   MAINNET_TOPUP_DAILY_USD=
# Mainnet RPCs (testnet builds ignore them): BASE_RPC=   ETHEREUM_RPC=   ARBITRUM_RPC=   MONAD_RPC= (chain 143 on mainnet)

# Chain integrations (all optional; public RPCs are used by default)
# ARBITRUM_SEPOLIA_RPC=   ROBINHOOD_TESTNET_RPC=   BASE_SEPOLIA_RPC=   SEPOLIA_RPC=   MONAD_RPC=
# Polymarket orders use real USDC.e on Polygon mainnet: off unless POLYMARKET_LIVE=1 (NEXT_PUBLIC_POLYMARKET_LIVE=1 for the catalog)
# POLYMARKET_LIVE=   NEXT_PUBLIC_POLYMARKET_LIVE=   POLYGON_RPC=   POLYMARKET_CLOB_URL=
# Zcash: buying ZEC uses real funds via cross-chain routing: off unless ZCASH_LIVE=1 (NEXT_PUBLIC_ZCASH_LIVE=1 for the catalog)
# ZCASH_LIVE=   NEXT_PUBLIC_ZCASH_LIVE=
# Zcash balances: BLOCKCHAIR_API_KEY, or ZCASH_RPC (zebrad / zcashd with the address index)
# BLOCKCHAIR_API_KEY=   ZCASH_RPC=
