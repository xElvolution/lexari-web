# Copy to webapp/.env.local. Never commit the filled-in file.

# Solana
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_LEXARI_PROGRAM_ID=BbnD28xf3kwfQRiRA6VQmw4p2R55WivUgozSoo81M6Po

# Origins, no trailing slash. Leave blank locally (defaults to :3000 and :3001).
NEXT_PUBLIC_LANDING_URL=
NEXT_PUBLIC_WEBAPP_URL=

# Devnet USDC mint, if paid hires use USDC. Blank means SOL only.
NEXT_PUBLIC_USDC_MINT=

# Postgres (Neon or Supabase). Required for sign-in, chat, and Hub.
DATABASE_URL=

# 16+ random characters. HMAC key for session cookies. Not a wallet key.
SESSION_SECRET=

# OpenAI-compatible chat. Set OPENAI_BASE_URL for SpaceXAI or another host.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Public treasury that receives hire payments. Defaults to the deployer wallet.
NEXT_PUBLIC_LEXARI_TREASURY=

# Base58 secret of the quest attestor. Co-signs claim_quest, open_box, claim_referral_tier.
# This is a server key. Do not put it in a NEXT_PUBLIC_ variable.
LEXARI_ATTESTOR_KEY=
