# Copy to webapp/.env.local (dev) or the server's webapp env (prod). Never commit the filled-in file.

# --- Sites (origins, no trailing slash; blank locally = :3000 and :3001) ---
NEXT_PUBLIC_LANDING_URL=
NEXT_PUBLIC_WEBAPP_URL=
# The exact origin users sign in on. Sign-in messages are bound to it.
LEXARI_APP_ORIGIN=
# 1 behind nginx (X-Real-IP / X-Forwarded-For), "cloudflare" behind Cloudflare, blank for direct.
TRUST_PROXY=

# --- Database and sessions (required) ---
DATABASE_URL=
# 32+ random characters (openssl rand -base64 48). HMAC key for session cookies.
SESSION_SECRET=

# --- Solana ---
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# Server-side RPC (defaults to NEXT_PUBLIC_SOLANA_RPC).
SOLANA_RPC=
NEXT_PUBLIC_LEXARI_PROGRAM_ID=BbnD28xf3kwfQRiRA6VQmw4p2R55WivUgozSoo81M6Po
# Secret key (JSON array or base58) of the Hub attestor. Must match config.authority onchain (init-config.mjs).
LEXARI_ATTESTOR_KEY=

# --- Hires (hiring stays closed until a treasury is set) ---
LEXARI_TREASURY=
NEXT_PUBLIC_LEXARI_TREASURY=
NEXT_PUBLIC_HIRE_LAMPORTS=10000000
NEXT_PUBLIC_HIRE_USDC=
NEXT_PUBLIC_USDC_MINT=

# --- Privy (Google / email sign-in). Allowed domains and Solana embedded wallets are set in the Privy dashboard. ---
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: the app's verification key (PEM). Fetched from Privy when blank.
PRIVY_VERIFICATION_KEY=

# --- Model provider: openai | xai | grok-cli (default: xai if XAI_API_KEY is set, else openai) ---
LLM_PROVIDER=
LLM_TIMEOUT_MS=90000
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4
# grok-cli: runs the Grok CLI per reply with tools locked down. Needs `grok login` as the app user.
GROK_CLI_BIN=grok
GROK_CLI_HOME=
GROK_CLI_MODEL=
GROK_CLI_TIMEOUT_MS=120000
GROK_CLI_CONCURRENCY=2

# --- Chat limits per user ---
CHAT_PER_MINUTE=12
CHAT_PER_DAY=300
