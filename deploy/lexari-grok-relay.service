# Lexari Grok relay: the web app talks to root's Grok CLI login through a unix socket only.
# Install: cp to /etc/systemd/system/, then systemctl daemon-reload && systemctl enable --now lexari-grok-relay
[Unit]
Description=Lexari Grok CLI relay
After=network-online.target

[Service]
ExecStart=/usr/bin/node /opt/lexari-web/grok-relay/grok-relay.mjs
User=root
Group=lexariweb
UMask=0007
RuntimeDirectory=lexari-grok
RuntimeDirectoryMode=0750
Environment=RELAY_SOCKET=/run/lexari-grok/grok.sock GROK_CLI_BIN=/opt/grok/grok GROK_HOME=/root RELAY_CONCURRENCY=2
Restart=always
RestartSec=2
# containment: root's uid for its own ~/.grok, and nothing else
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/.grok
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1G

[Install]
WantedBy=multi-user.target
